# 本文件只由 `make models` 读取，不与项目根目录的应用 .env 共用。
TKTKGO_LOCAL_PROVIDER_LOG=INFO

# faster-whisper 默认启用；HTTP 服务启动后，模型在第一次转写请求时加载。
TKTKGO_FASTER_WHISPER_ENABLED=true
TKTKGO_FASTER_WHISPER_MODEL=large-v3
TKTKGO_FASTER_WHISPER_DEVICE=cpu
TKTKGO_FASTER_WHISPER_COMPUTE_TYPE=int8
TKTKGO_FASTER_WHISPER_LANGUAGE=zh
TKTKGO_FASTER_WHISPER_CPU_THREADS=0
TKTKGO_FASTER_WHISPER_NUM_WORKERS=1
TKTKGO_FASTER_WHISPER_HOST=127.0.0.1
TKTKGO_FASTER_WHISPER_PORT=8102

# CosyVoice 需要先完成官方仓库、Python 环境和参考音频准备，再改为 true。
TKTKGO_COSYVOICE_ENABLED=false
TKTKGO_COSYVOICE_MODEL=FunAudioLLM/Fun-CosyVoice3-0.5B-2512
TKTKGO_COSYVOICE_ROOT=./local-providers/cosyvoice/CosyVoice
TKTKGO_COSYVOICE_PYTHON=./local-providers/cosyvoice/.venv/bin/python
TKTKGO_COSYVOICE_VOICES_FILE=./local-providers/cosyvoice/voices.json
TKTKGO_COSYVOICE_HOST=127.0.0.1
TKTKGO_COSYVOICE_PORT=8101
TKTKGO_COSYVOICE_FP16=false
