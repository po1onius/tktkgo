TKTKGO_DATABASE_URL=postgres://tktkgo:tktkgo@localhost:5432/tktkgo
TKTKGO_API_ADDR=0.0.0.0:8000
TKTKGO_WORKFLOW_ADDR=0.0.0.0:9080
TKTKGO_RESTATE_INGRESS_URL=http://localhost:8080
TKTKGO_RENDERER_URL=http://localhost:8090
TKTKGO_PUBLIC_ASSET_BASE_URL=http://localhost:8000/assets
TKTKGO_ASSET_ROOT=./storage
TKTKGO_OPENAI_BASE_URL=https://api.openai.com/v1
TKTKGO_OPENAI_API_KEY=
TKTKGO_TEXT_MODEL=gpt-5.6-terra
TKTKGO_IMAGE_MODEL=gpt-image-2
TKTKGO_TTS_MODEL=gpt-4o-mini-tts
TKTKGO_TRANSCRIBE_MODEL=whisper-1

# 应用只配置独立本地 Provider 的访问地址；模型、设备和路径由 local-providers/.env 管理。
TKTKGO_COSYVOICE_BASE_URL=http://127.0.0.1:8101
TKTKGO_FASTER_WHISPER_BASE_URL=http://127.0.0.1:8102
TKTKGO_LOG=info,tktkgo=debug
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
